@model List<GestionMascotas.Models.Mascota>

<h1 class="mb-3">Lista de Mascotas</h1>

<a class="btn btn-primary mb-3" asp-action="Create">+ Nueva Mascota</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Raza</th>
            <th>Vacunado</th>
        </tr>
    </thead>

    <tbody>
    @foreach (var mascota in Model)
    {
        <tr>
            <td>@mascota.Id</td>
            <td>@mascota.Nombre</td>
            <td>@mascota.Raza</td>
            <td>
                @if (mascota.Vacunado)
                {
                    <span class="badge bg-success">Sí</span>
                }
                else
                {
                    <span class="badge bg-danger">No</span>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
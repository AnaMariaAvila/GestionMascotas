@model List<GestionMascotas.Models.Mascota>

<h1>Lista de Mascotas</h1>

<a asp-action="Create">Nueva Mascota</a>

<table border="1">

    <tr>
        <th>Id</th>
        <th>Nombre</th>
        <th>Raza</th>
        <th>Vacunado</th>
    </tr>

    @foreach (var mascota in Model)
    {
        <tr>
            <td>@mascota.Id</td>
            <td>@mascota.Nombre</td>
            <td>@mascota.Raza</td>
            <td>@mascota.Vacunado</td>
        </tr>
    }

</table>